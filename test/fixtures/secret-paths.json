{
  "deny": [
    {
      "name": "cat-dotenv",
      "input": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "cat .env"
        }
      }
    },
    {
      "name": "cat-ssh-key",
      "input": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "cat ~/.ssh/id_ed25519"
        }
      }
    },
    {
      "name": "cat-aws-creds",
      "input": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "cat ~/.aws/credentials"
        }
      }
    },
    {
      "name": "cat-secrets-dir",
      "input": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "cat config/secrets/prod.yaml"
        }
      }
    },
    {
      "name": "cat-pem",
      "input": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "cat server.pem"
        }
      }
    },
    {
      "name": "edit-dotenv-production-path",
      "input": {
        "tool_name": "Edit",
        "tool_input": {
          "file_path": ".env.production",
          "old_string": "a",
          "new_string": "b"
        }
      }
    },
    {
      "name": "write-akia-content",
      "input": {
        "tool_name": "Write",
        "tool_input": {
          "file_path": "/tmp/notes.txt",
          "content": "the key is AKIAABCDEFGH12345678 do not share"
        }
      }
    },
    {
      "name": "multiedit-sk-live-content",
      "input": {
        "tool_name": "MultiEdit",
        "tool_input": {
          "file_path": "src/app.ts",
          "edits": [
            {
              "old_string": "a",
              "new_string": "const key='sk_live_abc123def456'"
            }
          ]
        }
      }
    },
    {
      "name": "write-pem-path",
      "input": {
        "tool_name": "Write",
        "tool_input": {
          "file_path": "key.pem",
          "content": "-----BEGIN RSA PRIVATE KEY-----\nabc\n-----END RSA PRIVATE KEY-----"
        }
      }
    }
  ],
  "allow": [
    {
      "name": "write-readme",
      "input": {
        "tool_name": "Write",
        "tool_input": {
          "file_path": "README.md",
          "content": "just some normal readme text with no secrets"
        }
      }
    },
    {
      "name": "edit-src-file",
      "input": {
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "src/index.ts",
          "old_string": "a",
          "new_string": "b"
        }
      }
    },
    {
      "name": "cat-package-json",
      "input": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "cat package.json"
        }
      }
    },
    {
      "name": "ssh-command-no-path",
      "input": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "ssh deploy@example.com uptime"
        }
      }
    },
    {
      "name": "read-tool-passthrough",
      "input": {
        "tool_name": "Read",
        "tool_input": {
          "file_path": ".env"
        }
      }
    }
  ]
}
